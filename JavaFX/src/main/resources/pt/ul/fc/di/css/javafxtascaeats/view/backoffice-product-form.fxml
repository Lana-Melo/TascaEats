<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="600.0" prefWidth="640.0"
      xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pt.ul.fc.di.css.javafxtascaeats.controller.BackOfficeProductFormController">

  <children>

    <MenuBar VBox.vgrow="NEVER">
      <menus>
        <Menu text="Help">
          <items>
            <MenuItem text="About TascaEats"/>
          </items>
        </Menu>
      </menus>
    </MenuBar>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
      <content>
        <VBox alignment="CENTER" spacing="15.0" prefWidth="640.0">
          <VBox spacing="10.0" maxWidth="500">
            <padding><Insets top="20" bottom="20"/></padding>

            <!-- Breadcrumb -->
            <HBox spacing="4" alignment="CENTER_LEFT">
              <Hyperlink text="Login" textFill="#a1a1a1" onAction="#handleGoLogin"/>
              <Label text="/"/>
              <Hyperlink text="Back Office" textFill="#a1a1a1" onAction="#handleGoBackOffice"/>
              <Label text="/"/>
              <Hyperlink text="Menus" textFill="#a1a1a1" onAction="#handleGoMenus"/>
              <Label text="/"/>
              <Hyperlink fx:id="menuBreadcrumb" textFill="#a1a1a1" onAction="#handleGoMenuEdit"/>
              <Label text="/"/>
              <Label fx:id="formTitleBreadcrumb"/>
            </HBox>

            <Label fx:id="formTitleLabel">
              <font><Font name="AppleGothic Regular" size="22.0"/></font>
            </Label>

            <Label text="Name"/>
            <TextField fx:id="designationField"/>

            <Label text="Description"/>
            <TextField fx:id="descriptionField"/>

            <Label text="Price"/>
            <TextField fx:id="priceField"/>

            <Label fx:id="errorLabel" textFill="red" visible="false" managed="false"/>

            <Button text="Save" maxWidth="Infinity" onAction="#handleSave"/>

          </VBox>
        </VBox>
      </content>
    </ScrollPane>

    <ToolBar prefHeight="40.0"/>

  </children>
</VBox>
