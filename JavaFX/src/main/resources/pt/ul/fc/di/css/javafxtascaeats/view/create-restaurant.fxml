<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="500.0" prefWidth="750.0"
      xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pt.ul.fc.di.css.javafxtascaeats.controller.CreateRestaurantController">

    <children>
        <MenuBar VBox.vgrow="NEVER">
            <menus>
                <Menu text="Menu">
                    <items>
                        <MenuItem text="About TascaEats"/>
                        <MenuItem text="Logout" onAction="#handleLogout"/>
                    </items>
                </Menu>
            </menus>
        </MenuBar>

        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
            <content>
                <VBox alignment="CENTER" spacing="15.0" prefWidth="750.0">

                    <VBox spacing="10.0" maxWidth="350">
                        <padding>
                            <Insets top="20" bottom="20"/>
                        </padding>

                        <HBox spacing="4">
                            <Hyperlink text="Home" textFill="#a1a1a1" onAction="#handleGoHome">
                                <font><Font name="AppleGothic Regular" size="11.0"/></font>
                            </Hyperlink>
                            <Label text="/" textFill="#a1a1a1"/>
                            <Hyperlink text="Restaurants" textFill="#a1a1a1" onAction="#handleGoRestaurants">
                                <font><Font name="AppleGothic Regular" size="11.0"/></font>
                            </Hyperlink>
                            <Label text="/" textFill="#a1a1a1"/>
                            <Label text="Create"/>
                        </HBox>

                        <Label text="Create Restaurant">
                            <font><Font name="AppleGothic Regular" size="22.0"/></font>
                        </Label>

                        <Label text="Designation"/>
                        <TextField fx:id="designationField" promptText="Designation"/>

                        <Label text="NIF"/>
                        <TextField fx:id="nifField" promptText="NIF"/>

                        <Label text="City"/>
                        <TextField fx:id="cityField" promptText="City"/>

                        <Label text="Postal Code"/>
                        <TextField fx:id="postalCodeField" promptText="Postal Code"/>

                        <Label text="Street"/>
                        <TextField fx:id="streetField" promptText="Street"/>

                        <Label text="Open Hours"/>
                        <TextField fx:id="openHoursField" promptText="HH:mm"/>

                        <Label text="Close Hours"/>
                        <TextField fx:id="closeHoursField" promptText="HH:mm"/>

                        <Label fx:id="errorLabel" textFill="red" visible="false" managed="false"/>

                        <Button fx:id="createButton" text="Create" maxWidth="Infinity"
                                onAction="#handleCreate">
                            <font><Font name="AppleGothic Regular" size="13.0"/></font>
                        </Button>

                    </VBox>

                </VBox>
            </content>
        </ScrollPane>

        <ToolBar prefHeight="40.0"/>
    </children>
</VBox>
