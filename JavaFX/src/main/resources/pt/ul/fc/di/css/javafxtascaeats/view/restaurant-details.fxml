<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="500.0" prefWidth="750.0"
      xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pt.ul.fc.di.css.javafxtascaeats.controller.RestaurantDetailsController">

    <children>
        <MenuBar VBox.vgrow="NEVER">
            <menus>
                <Menu text="Menu">
                    <items>
                        <MenuItem text="About TascaEats"/>
                        <MenuItem text="Logout" onAction="#handleLogout"/>
                    </items>
                </Menu>
            </menus>
        </MenuBar>

        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
            <content>
                <VBox alignment="CENTER" spacing="15.0" prefWidth="750.0">

                    <VBox spacing="10.0" maxWidth="350">
                        <padding>
                            <Insets top="20" bottom="20"/>
                        </padding>

                        <HBox spacing="4">
                            <Hyperlink text="Home" textFill="#a1a1a1" onAction="#handleGoHome">
                                <font><Font name="AppleGothic Regular" size="11.0"/></font>
                            </Hyperlink>
                            <Label text="/" textFill="#a1a1a1"/>
                            <Hyperlink text="Restaurants" textFill="#a1a1a1" onAction="#handleGoBack">
                                <font><Font name="AppleGothic Regular" size="11.0"/></font>
                            </Hyperlink>
                            <Label text="/" textFill="#a1a1a1"/>
                            <Label text="Details"/>
                        </HBox>

                        <Label fx:id="designationLabel">
                            <font><Font name="AppleGothic Regular" size="22.0"/></font>
                        </Label>

                        <VBox spacing="4">
                            <Label fx:id="addressLabel">
                                <font><Font name="AppleGothic Regular" size="13.0"/></font>
                            </Label>
                            <Label fx:id="statusLabel">
                                <font><Font name="AppleGothic Regular" size="13.0"/></font>
                            </Label>
                            <Label fx:id="openingHoursLabel">
                                <font><Font name="AppleGothic Regular" size="13.0"/></font>
                            </Label>
                        </VBox>

                        <Button fx:id="manageRestaurantButton" text="Manage Restaurant" maxWidth="Infinity"
                        onAction="#handleManageRestaurant" HBox.hgrow="ALWAYS">
                            <font><Font name="AppleGothic Regular" size="13.0"/></font>
                        </Button>

                    </VBox>

                </VBox>
            </content>
        </ScrollPane>

        <ToolBar prefHeight="40.0"/>
    </children>
</VBox>
