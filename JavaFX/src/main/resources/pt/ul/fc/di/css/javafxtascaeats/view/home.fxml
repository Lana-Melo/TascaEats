<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="400.0" prefWidth="640.0"
      xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pt.ul.fc.di.css.javafxtascaeats.controller.HomeController">
  <children>
    <MenuBar VBox.vgrow="NEVER">
      <menus>
        <Menu mnemonicParsing="false" text="Help">
          <items>
            <MenuItem mnemonicParsing="false" text="About TascaEats" />
          </items>
        </Menu>
      </menus>
    </MenuBar>

    <AnchorPane VBox.vgrow="ALWAYS">
      <children>
        <VBox alignment="CENTER" spacing="12.0"
              AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
              AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

          <VBox alignment="CENTER" spacing="8.0" maxWidth="200">
            <padding>
              <Insets top="20" bottom="20"/>
            </padding>

            <Label fx:id="welcomeLabel">
              <font><Font name="AppleGothic Regular" size="22.0"/></font>
            </Label>

            <Label fx:id="roleLabel">
              <font><Font name="AppleGothic Regular" size="13.0"/></font>
            </Label>

            <!-- CLIENT -->
            <Label fx:id="clientMessageLabel" wrapText="true" textAlignment="CENTER"
                   text="Sorry, go to TascaEats website to continue navigate as a Client. This portal is designed to admins and delivery persons."
                   visible="false" managed="false">
              <font><Font name="AppleGothic Regular" size="12.0"/></font>
            </Label>
            <Hyperlink fx:id="clientLink" text="http://localhost:8080/"
                       visible="false" managed="false"/>

            <!-- DELIVERY_PERSON -->
            <Button fx:id="ordersButton" text="See my orders" maxWidth="Infinity"
                    onAction="#handleSeeOrders"
                    visible="false" managed="false">
              <font><Font name="AppleGothic Regular" size="13.0"/></font>
            </Button>

            <!-- ADMIN -->
            <Button fx:id="restaurantsButton" text="Manage restaurant(s)" maxWidth="Infinity"
                    onAction="#handleManageRestaurants"
                    visible="false" managed="false">
              <font><Font name="AppleGothic Regular" size="13.0"/></font>
            </Button>

          </VBox>
        </VBox>
      </children>
    </AnchorPane>

    <ToolBar prefHeight="40.0" prefWidth="200.0" />
  </children>
</VBox>
