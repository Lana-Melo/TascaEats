<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="400.0" prefWidth="640.0"
      xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pt.ul.fc.di.css.javafxtascaeats.controller.LoginController">
  <children>
    <MenuBar VBox.vgrow="NEVER">
      <menus>
        <Menu mnemonicParsing="false" text="Help">
          <items>
            <MenuItem mnemonicParsing="false" text="About TascaEats" />
          </items>
        </Menu>
      </menus>
    </MenuBar>

    <AnchorPane VBox.vgrow="ALWAYS">
      <children>
        <VBox alignment="CENTER" spacing="12.0"
              AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
              AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

          <VBox alignment="CENTER" spacing="12.0" maxWidth="200">
            <padding>
              <Insets top="20" bottom="20"/>
            </padding>

            <Label text="TascaEats">
              <font><Font name="AppleGothic Regular" size="29.0"/></font>
            </Label>

            <TextField fx:id="emailField" promptText="user@tascaeats.com">
              <font><Font name="AppleGothic Regular" size="13.0"/></font>
            </TextField>

            <PasswordField fx:id="passwordField" promptText="password">
              <font><Font name="AppleGothic Regular" size="13.0"/></font>
            </PasswordField>

            <Button defaultButton="true" mnemonicParsing="false"
                    text="Login" textAlignment="CENTER" onAction="#handleLogin"
                    maxWidth="Infinity">
              <font><Font name="AppleGothic Regular" size="13.0"/></font>
            </Button>

            <Hyperlink text="Create account" textFill="#a1a1a1"/>
          </VBox>

        </VBox>
      </children>
    </AnchorPane>

    <ToolBar prefHeight="40.0" prefWidth="200.0" />
  </children>
</VBox>
