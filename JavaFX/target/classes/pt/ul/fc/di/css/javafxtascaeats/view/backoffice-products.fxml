<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="600.0" prefWidth="640.0"
      xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pt.ul.fc.di.css.javafxtascaeats.controller.BackOfficeProductsController">

  <children>

    <MenuBar VBox.vgrow="NEVER">
      <menus>
        <Menu text="Help">
          <items>
            <MenuItem text="About TascaEats"/>
          </items>
        </Menu>
      </menus>
    </MenuBar>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
      <content>

        <VBox alignment="CENTER" spacing="15.0" prefWidth="640.0">

          <VBox spacing="10.0" maxWidth="500">
            <padding><Insets top="20" bottom="20"/></padding>

            <HBox spacing="4" alignment="CENTER_LEFT">
              <Hyperlink text="Login" textFill="#a1a1a1" onAction="#handleGoLogin"/>
              <Label text="/"/>
              <Hyperlink text="Back Office" textFill="#a1a1a1" onAction="#handleGoBackOffice"/>
              <Label text="/"/>
              <Label text="Products"/>
            </HBox>

            <Label text="Products">
              <font><Font name="AppleGothic Regular" size="22.0"/></font>
            </Label>


            <CheckBox fx:id="cbDesignation" text="Name"/>
            <TextField fx:id="designationField" visible="false" managed="false"/>

            <CheckBox fx:id="cbPrice" text="Max Price"/>
            <TextField fx:id="priceField" visible="false" managed="false"/>

            <CheckBox fx:id="cbDescription" text="Category"/>
            <TextField fx:id="descriptionField" visible="false" managed="false"/>

            <CheckBox fx:id="cbAvailability" text="Availability"/>
            <ComboBox fx:id="availabilityCombo" visible="false" managed="false"/>

            <CheckBox fx:id="cbTimesOrdered" text="Min Times Ordered"/>
            <TextField fx:id="timesOrderedField" visible="false" managed="false"/>

            <Button text="Search" maxWidth="Infinity" onAction="#handleSearch"/>

            <Label fx:id="errorLabel" textFill="red" visible="false" managed="false"/>

            <TableView fx:id="productsTable"
                       prefHeight="300.0"
                       maxWidth="Infinity"
                       visible="false"
                       managed="false">

              <columns>
                <TableColumn fx:id="colDesignation" text="Name"/>
                <TableColumn fx:id="colPrice" text="Price"/>
                <TableColumn fx:id="colDescription" text="Category"/>
                <TableColumn fx:id="colAvailability" text="Availability"/>
              </columns>

              <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
              </columnResizePolicy>

            </TableView>

          </VBox>

        </VBox>

      </content>
    </ScrollPane>

    <ToolBar prefHeight="40.0"/>

  </children>
</VBox>
