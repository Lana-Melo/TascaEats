<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="600.0" prefWidth="800.0"
      xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pt.ul.fc.di.css.javafxtascaeats.controller.RestaurantProductsController">

    <children>
        <MenuBar VBox.vgrow="NEVER">
            <menus>
                <Menu text="Menu">
                    <items>
                        <MenuItem text="About TascaEats"/>
                        <MenuItem text="Logout" onAction="#handleLogout"/>
                    </items>
                </Menu>
            </menus>
        </MenuBar>

        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
            <content>
                <VBox alignment="CENTER" spacing="15.0" prefWidth="800.0">

                    <VBox spacing="10.0" maxWidth="600">
                        <padding>
                            <Insets top="20" bottom="20"/>
                        </padding>

                        <HBox spacing="4">
                            <Hyperlink text="Home" textFill="#a1a1a1" onAction="#handleGoHome">
                                <font><Font name="AppleGothic Regular" size="11.0"/></font>
                            </Hyperlink>
                            <Label text="/" textFill="#a1a1a1"/>
                            <Hyperlink text="Restaurants" textFill="#a1a1a1" onAction="#handleGoRestaurants">
                                <font><Font name="AppleGothic Regular" size="11.0"/></font>
                            </Hyperlink>
                            <Label text="/" textFill="#a1a1a1"/>
                            <Hyperlink fx:id="restaurantBreadcrumb" textFill="#a1a1a1" onAction="#handleGoRestaurantDetails">
                                <font><Font name="AppleGothic Regular" size="11.0"/></font>
                            </Hyperlink>
                            <Label text="/" textFill="#a1a1a1"/>
                            <Label text="Products"/>
                        </HBox>

                        <Label text="Products">
                            <font><Font name="AppleGothic Regular" size="22.0"/></font>
                        </Label>

                        <Label text="Search Filters"/>

                        <FlowPane hgap="10" vgap="8">
                            <CheckBox fx:id="designationCheckBox" text="Name" selected="true" disable="true"/>
                            <CheckBox fx:id="priceCheckBox" text="Max Price"/>
                            <CheckBox fx:id="descriptionCheckBox" text="Description"/>
                            <CheckBox fx:id="availabilityCheckBox" text="Availability"/>
                            <CheckBox fx:id="timesOrderedCheckBox" text="Min Times Ordered"/>
                        </FlowPane>

                        <Label fx:id="designationLabel" text="Name"/>
                        <TextField fx:id="designationField" promptText="Name"/>

                        <Label fx:id="priceLabel" text="Max Price" visible="false" managed="false"/>
                        <TextField fx:id="priceField" promptText="Max Price" visible="false" managed="false"/>

                        <Label fx:id="descriptionLabel" text="Description" visible="false" managed="false"/>
                        <TextField fx:id="descriptionField" promptText="Description" visible="false" managed="false"/>

                        <Label fx:id="availabilityLabel" text="Availability" visible="false" managed="false"/>
                        <ComboBox fx:id="availabilityField" promptText="Select availability" maxWidth="Infinity" visible="false" managed="false"/>

                        <Label fx:id="timesOrderedLabel" text="Min Times Ordered" visible="false" managed="false"/>
                        <TextField fx:id="timesOrderedField" promptText="Min Times Ordered" visible="false" managed="false"/>

                        <Button text="Search" maxWidth="Infinity" onAction="#handleSearch">
                            <font><Font name="AppleGothic Regular" size="13.0"/></font>
                        </Button>

                        <TableView fx:id="productsTable" prefHeight="250.0" maxWidth="Infinity">
                            <columns>
                                <TableColumn fx:id="nameColumn" text="Name" prefWidth="150"/>
                                <TableColumn fx:id="priceColumn" text="Price" prefWidth="80"/>
                                <TableColumn fx:id="descriptionColumn" text="Description" prefWidth="200"/>
                                <TableColumn fx:id="statusColumn" text="Status" prefWidth="100"/>
                                <TableColumn fx:id="editColumn" text="" prefWidth="50"/>
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                        </TableView>

                        <Label fx:id="errorLabel" textFill="red" visible="false" managed="false"/>

                    </VBox>

                </VBox>
            </content>
        </ScrollPane>

        <ToolBar prefHeight="40.0"/>
    </children>
</VBox>
